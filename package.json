{
  "name": "rca-bot",
  "version": "0.1.0",
  "description": "Alarm-to-root-cause bot: catalog-bounded Logs Insights queries, LLM hypotheses that must cite evidence, and a deterministic verifier.",
  "type": "module",
  "license": "MIT",
  "bin": { "rca": "dist/cli/main.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "scenarios", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bundle": "node scripts/bundle.mjs",
    "synth": "npm run bundle && cdk synth --all --quiet --no-notices",
    "rca": "tsx src/cli/main.ts",
    "lint:catalog": "tsx src/cli/main.ts catalog lint",
    "eval:baseline": "tsx src/cli/main.ts eval run --model heuristic --scenarios all --repeat 3",
    "bench:fabrication": "tsx src/cli/main.ts eval fabrication --repeat 3",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1146.0",
    "@aws-sdk/client-cloudwatch": "3.1146.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1146.0",
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/client-lambda": "3.1146.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/client-ssm": "3.1146.0",
    "@aws-sdk/lib-dynamodb": "3.1146.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.1",
    "aws-cdk": "2.1144.0",
    "aws-cdk-lib": "2.272.0",
    "aws-sdk-client-mock": "4.1.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

# Optional. Never commit real values.
# Slack incoming webhook; when unset, cards go to the local sink (http://localhost:5350) or .rca/slack/.
SLACK_WEBHOOK_URL=
# Ollama for local LLM runs (rca demo/eval --model ollama:qwen3.8:27b)
OLLAMA_BASE_URL=http://localhost:11434
# Only for docker-compose.localstack.yml (LocalStack 2026.03+ requires a token; Hobby plan is non-commercial)
LOCALSTACK_AUTH_TOKEN=
